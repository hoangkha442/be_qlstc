{
  "name": "server",
  "version": "2.0.0",
  "description": "API cổng học tập Đại cương và Chuyên ngành CNTT",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "provision:lecturer": "yarn build && node dist/seed.js",
    "check:storage": "yarn build && node dist/check-storage.js",
    "lint": "oxlint src/",
    "verify": "yarn lint && yarn build"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/mongoose": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.1.1",
    "@nestjs/throttler": "^6.7.1",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "cfb": "^1.2.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.11.0",
    "crc-32": "^1.2.2",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.12.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.12.1",
